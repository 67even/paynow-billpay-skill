Claude outputs/
Reviews/

# Eval workspace: generated run outputs, gradings, benchmarks and review pages
paynow-paybill-skills-workspace/
*-workspace/
*-eval-review*.html
feedback.json

# Packaged skill bundles — rebuild with the zip command in README.md, don't commit binaries
*.skill
*.zip

# ---------------------------------------------------------------------------
# Secrets — BillPay credentials and webhook secret keys must never reach version control
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
!billpay.env.example
*.key
*.pem
secrets.json

