# Paynow BillPay configuration — copy into your .env (never commit real values)

# Base URL. Paynow does not publish a separate sandbox URL; test behaviour comes
# from test credentials + the Test Biller. Keep it configurable anyway.
BILLPAY_BASE_URL=https://billpay.paynow.co.zw

# Vendor API user (role "API") or Biller user (role "Biller Admin"/"Biller User")
BILLPAY_USERNAME=
BILLPAY_PASSWORD=

# HTTP timeout in seconds (Paynow recommends 60)
BILLPAY_TIMEOUT=60

# Vendor: bearer token for the biller-config webhook.
# Leave EMPTY until the BillPay team confirms they have configured it — enforcing
# it early makes every webhook fail (UAT test 6).
BILLPAY_WEBHOOK_TOKEN=

# Biller: secret key issued by the BillPay system admin for payment webhooks
BILLPAY_SECRET_KEY=

# Status polling (seconds) — values specified by Paynow; do not lower them
BILLPAY_POLL_FIRST_DELAY=120
BILLPAY_POLL_INTERVAL=180
BILLPAY_POLL_FLAGGED_INTERVAL=600
# Your own cap before escalating to operations staff (recommendation)
BILLPAY_POLL_MAX_ATTEMPTS=10

# Alert operations staff when a wallet falls below this amount (per currency)
BILLPAY_LOW_BALANCE_ZWG=
BILLPAY_LOW_BALANCE_USD=
